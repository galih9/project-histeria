[gd_resource type="Resource" script_class="SkillData" format=3]

[ext_resource type="Script" path="res://data/definitions/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://data/definitions/effects/damage_effect.gd" id="2_damage"]
[ext_resource type="Script" path="res://data/definitions/skill_data.gd" id="3_skill"]
[ext_resource type="Script" path="res://data/definitions/effects/apply_status_effect.gd" id="4_status"]
[ext_resource type="Resource" path="res://data/statuses/stun.tres" id="5_stun"]

[sub_resource type="Resource" id="Resource_spell"]
script = ExtResource("2_damage")
damage_type = 1
power = 11.0
hit_fx = 2
element = 3

[sub_resource type="Resource" id="Resource_stun"]
script = ExtResource("4_status")
status = ExtResource("5_stun")
stacks = 1
requires_hit = true

[resource]
script = ExtResource("3_skill")
mp_cost = 7
text_id = &"frost_incantation"
display_name = "Frost Incantation"
effects = Array[ExtResource("1_effect")]([SubResource("Resource_spell"), SubResource("Resource_stun")])
requires_weapon = true
